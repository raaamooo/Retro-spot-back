generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Users/Admin Workers
model User {
  id           String   @id @default(uuid())
  name         String
  role         String   // barista, waiter, cashier, inventory, manager, organizer
  phone        String?
  email        String?  @unique
  passwordHash String
  pin          String?  // 4-digit manager override PIN
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedOrders Order[]   @relation("AssignedWaiter")
  shiftLogs      ShiftLog[]
}

// 2. Locations
model Location {
  id            String   @id @default(uuid())
  name          String   // "Table 1", "Room 1"
  type          String   // table, room, workspace, custom
  qrCodeUrl     String?
  active        Boolean  @default(true)
  orders        Order[]
  waiterCalls   WaiterCall[]
  receiptGroups ReceiptGroup[]
}

// 3. Menu Categories
model MenuCategory {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  items     MenuItem[]
}

// 4. Menu Items
model MenuItem {
  id            String   @id @default(uuid())
  categoryId    String
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  price         Float
  imageUrl      String?
  available     Boolean  @default(true)
  tags          String?  // comma-separated for "Play With Us"
  active        Boolean  @default(true)

  category      MenuCategory @relation(fields: [categoryId], references: [id])
  recipes       Recipe[]
  orderItems    OrderItem[]
}

// 5. Additions
model Addition {
  id                    String   @id @default(uuid())
  nameEn                String
  nameAr                String
  price                 Float
  imageUrl              String?
  compatibleMenuItemIds String?  // comma separated JSON array representation
  active                Boolean  @default(true)
}

// ═══════════════════════════════════════════════════════════
//  INVENTORY SYSTEM (v2 — rebuilt from scratch)
// ═══════════════════════════════════════════════════════════

// 6. Ingredients — master list
model Ingredient {
  id            String    @id @default(uuid())
  nameEn        String
  nameAr        String
  unit          String    // grams, ml, pieces, kg
  currentStock  Float     @default(0)
  minimumStock  Float     @default(10)
  costPerUnit   Float     @default(0)
  category      String?   // dairy, fruits, syrups, dry goods, packaging, etc.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ingredientSupplier IngredientSupplier?
  recipes            Recipe[]
  purchaseHistory    PurchaseHistory[]
  stockDeductions    StockDeduction[]
  stockAlerts        StockAlert[]
}

// 7. Suppliers
model Supplier {
  id          String    @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())

  ingredientSuppliers IngredientSupplier[]
  purchaseHistory     PurchaseHistory[]
}

// 8. IngredientSupplier — one supplier per ingredient
model IngredientSupplier {
  id           String @id @default(uuid())
  ingredientId String @unique
  supplierId   String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// 9. Recipes — which ingredients per menu item
model Recipe {
  id               String @id @default(uuid())
  menuItemId       String
  ingredientId     String
  quantityRequired Float  // how much of ingredient per 1 serving

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

// 10. Purchase History — restock log
model PurchaseHistory {
  id            String    @id @default(uuid())
  ingredientId  String
  supplierId    String?
  quantityAdded Float
  pricePerUnit  Float     // price paid per unit at time of purchase
  totalCost     Float     // quantityAdded * pricePerUnit (computed at insert)
  purchasedAt   DateTime  @default(now())
  notes         String?
  adminId       String?   // who logged the restock

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
}

// 11. Stock Deductions — audit trail
model StockDeduction {
  id               String   @id @default(uuid())
  ingredientId     String
  quantityDeducted Float
  reason           String   // 'order', 'manual_adjustment', 'waste'
  orderId          String?  // if reason is 'order'
  deductedAt       DateTime @default(now())
  adminId          String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

// 12. Stock Alerts — low stock & out of stock alerts log
model StockAlert {
  id           String    @id @default(uuid())
  ingredientId String
  alertType    String    // 'low_stock', 'out_of_stock'
  triggeredAt  DateTime  @default(now())
  resolvedAt   DateTime?
  isResolved   Boolean   @default(false)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
//  ORDERS & POS
// ═══════════════════════════════════════════════════════════

// 13. Orders
model Order {
  id              String   @id @default(uuid())
  locationId      String
  customerName    String?
  notes           String?
  paymentMethod   String?  // cash, visa, wallet, split
  tipAmount       Float    @default(0)
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  discountAmount  Float    @default(0)
  serviceCharge   Float    @default(0)
  total           Float    @default(0)
  status          String   @default("placed") // placed, barista, waiter, cashier, completed
  orderType       String   @default("dine_in") // dine_in, takeaway, delivery
  priority        String   @default("normal") // normal, rush
  archived        Boolean  @default(false)
  refundAmount    Float    @default(0)
  refundReason    String?
  splitPayments   String?  // JSON: [{method, amount}]
  assignedWaiterId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location        Location  @relation(fields: [locationId], references: [id])
  assignedWaiter  User?     @relation("AssignedWaiter", fields: [assignedWaiterId], references: [id])
  items           OrderItem[]
  receiptGroup    ReceiptGroup? @relation(fields: [receiptGroupId], references: [id])
  receiptGroupId  String?
}

// 14. Order Items
model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  menuItemId      String
  quantity        Int
  additions       String?  // JSON string
  itemPriceAtTime Float
  notes           String?
  status          String   @default("ordered") // ordered, preparing, ready, served
  voidReason      String?
  voided          Boolean  @default(false)

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
}

// 15. Waiter Calls
model WaiterCall {
  id         String    @id @default(uuid())
  locationId String
  type       String    @default("waiter") // "waiter", "check"
  status     String    @default("active") // active, resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  location   Location  @relation(fields: [locationId], references: [id])
}

// 16. Receipt Groups
model ReceiptGroup {
  id         String    @id @default(uuid())
  locationId String
  status     String    @default("open") // open, printed, paid, cleared
  total      Float     @default(0)
  printedAt  DateTime?
  clearedAt  DateTime?

  location   Location  @relation(fields: [locationId], references: [id])
  orders     Order[]
}

// 17. Bookings
model Booking {
  id                       String    @id @default(uuid())
  eventType                String
  name                     String
  peopleCount              Int
  notes                    String?
  date                     String
  startTime                String
  endTime                  String
  paymentMethod            String?   // card, instapay, mobile_wallet
  paymentStatus            String    @default("pending") // pending, submitted, verified, rejected
  transactionScreenshotUrl String?
  totalPrice               Float     @default(0)
  status                   String    @default("pending") // pending, confirmed, cancelled, completed
  createdAt                DateTime  @default(now())
}

// 18. Arts
model Art {
  id            String   @id @default(uuid())
  titleEn       String
  titleAr       String
  artistName    String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  price         Float
  status        String   @default("submitted") // submitted, approved, rejected, selected_for_bid, sold
  contactInfo   String?
  createdAt     DateTime @default(now())
  bids          ArtBid[]
}

// 19. Art Bids
model ArtBid {
  id                       String   @id @default(uuid())
  artId                    String
  bidderName               String
  bidderContact            String
  bidAmount                Float
  paymentMethod            String?
  paymentStatus            String?
  transactionScreenshotUrl String?
  status                   String   @default("active") // active, winning, lost, paid, archived
  createdAt                DateTime @default(now())

  art                      Art      @relation(fields: [artId], references: [id])
}

// 20. News
model News {
  id            String    @id @default(uuid())
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  type          String    // new_item, event, discount, announcement
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
}

// 21. Accounting Records
model AccountingRecord {
  id            String   @id @default(uuid())
  source        String   // menu, booking, art, bid, tip
  amount        Float
  paymentMethod String
  relatedId     String?  // Reference ID of order, booking, or art
  createdAt     DateTime @default(now())
}

// 22. System Configuration
model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
  label String? // human-readable label
}

// 23. Loyalty Accounts
model LoyaltyAccount {
  id            String   @id @default(uuid())
  phoneNumber   String   @unique
  customerName  String?
  pointsBalance Float    @default(0)
  totalEarned   Float    @default(0)
  totalRedeemed Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 24. Shift Logs
model ShiftLog {
  id            String    @id @default(uuid())
  userId        String
  startTime     DateTime  @default(now())
  endTime       DateTime?
  expectedCash  Float     @default(0)
  countedCash   Float     @default(0)
  discrepancy   Float     @default(0)
  totalRevenue  Float     @default(0)
  totalOrders   Int       @default(0)
  totalVoids    Int       @default(0)
  totalTips     Float     @default(0)
  notes         String?

  user          User      @relation(fields: [userId], references: [id])
}
